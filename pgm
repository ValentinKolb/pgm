#!/usr/bin/env bash
# pgm — manage PostgreSQL application databases
# One database per app, one user per database. Opinionated and small.
set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
# Optional config file is sourced first. Use ': "${VAR:=value}"' inside it so
# environment variables (already set when the script starts) take precedence.
[ -f /etc/pgm/pgm.conf ] && . /etc/pgm/pgm.conf

: "${PGM_DB_HOST:=localhost}"
: "${PGM_DB_PORT:=5432}"
: "${PGM_SECRETS_DIR:=/root/.pg-app-secrets}"
: "${PGM_PSQL_CMD:=sudo -u postgres psql}"
: "${PGM_SAVE_ENV:=true}"
: "${PGM_PG_STAT_STATEMENTS:=true}"
: "${PGM_SUGGEST_HBA_CHANGE:=true}"

readonly USER_SUFFIX='_app'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die() { printf 'Error: %s\n' "$1" >&2; exit "${2:-2}"; }
hr()  { printf '════════════════════════════════════════════════════════════════\n'; }

validate_app_name() {
    local name=$1
    [[ "$name" =~ ^[a-z][a-z0-9_]{0,29}$ ]] \
        || die "Invalid app name '$name'. Must be lowercase letters, digits, underscores; 1-30 chars; start with a letter."
    case "$name" in
        postgres|template0|template1|pgbouncer)
            die "Reserved name: $name" ;;
    esac
}

# PGM_PSQL_CMD is intentionally unquoted so word-splitting works
# ("sudo -u postgres psql"). Standard psql flags are appended for safety.
psql_admin() {
    $PGM_PSQL_CMD --quiet --no-psqlrc --set ON_ERROR_STOP=on "$@"
}

# Same as psql_admin, but tuples-only and unaligned — for queries we parse.
psql_query() {
    $PGM_PSQL_CMD --quiet --no-psqlrc --set ON_ERROR_STOP=on -tA "$@"
}

# URL-safe alphanumeric of length 32.
gen_password() {
    openssl rand -base64 48 | tr -d '/+=' | cut -c1-32
}

db_exists()   { [ "$(psql_query -c "SELECT 1 FROM pg_database WHERE datname='$1'")" = "1" ]; }
role_exists() { [ "$(psql_query -c "SELECT 1 FROM pg_roles    WHERE rolname='$1'")" = "1" ]; }

# Refuse to touch DBs not owned by an app role — primary defense against
# accidentally deleting unrelated databases.
role_owns_db() {
    [ "$(psql_query -c "
        SELECT 1 FROM pg_database d
        JOIN pg_roles r ON d.datdba = r.oid
        WHERE d.datname='$2' AND r.rolname='$1'")" = "1" ]
}

# .env file: atomic write, chmod 600.
write_env_file() {
    local app=$1 password=$2
    local user="${app}${USER_SUFFIX}"
    local file="$PGM_SECRETS_DIR/$app.env"
    local pg_url="postgresql://$user:$password@$PGM_DB_HOST:$PGM_DB_PORT/$app"

    mkdir -p "$PGM_SECRETS_DIR"
    chmod 700 "$PGM_SECRETS_DIR"

    local tmp="$file.tmp"
    {
        printf '# pgm-managed; do not edit manually. App: %s. Created: %s.\n' \
            "$app" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'PG_HOST=%s\n'     "$PGM_DB_HOST"
        printf 'PG_PORT=%s\n'     "$PGM_DB_PORT"
        printf 'PG_DATABASE=%s\n' "$app"
        printf 'PG_USER=%s\n'     "$user"
        printf 'PG_PASSWORD=%s\n' "$password"
        printf 'PG_URL=%s\n'      "$pg_url"
    } > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$file"
}

# Used by both `create` and `rotate-password`.
print_creds_block() {
    local heading=$1 app=$2 password=$3 saved_path=$4
    local user="${app}${USER_SUFFIX}"
    local pg_url="postgresql://$user:$password@$PGM_DB_HOST:$PGM_DB_PORT/$app"
    hr
    printf '%s: %s\n' "$heading" "$app"
    hr
    printf '\n'
    printf 'User:       %s\n' "$user"
    printf 'Password:   %s\n' "$password"
    printf 'URL:        %s\n' "$pg_url"
    printf '\n'
    if [ -n "$saved_path" ]; then
        printf 'Saved to:   %s\n' "$saved_path"
    else
        printf '⚠  Save the password now — it will not be shown again.\n'
    fi
    hr
}

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------
cmd_create() {
    [ $# -eq 1 ] || die "Usage: pgm create <app>"
    local app=$1
    validate_app_name "$app"
    local user="${app}${USER_SUFFIX}"

    db_exists   "$app"  && die "Database '$app' already exists."  2
    role_exists "$user" && die "Role '$user' already exists."     2

    local password
    password=$(gen_password)

    # CREATE DATABASE cannot run inside a transaction block, so this batch is
    # not wrapped in BEGIN/COMMIT. ON_ERROR_STOP still aborts on the first error.
    psql_admin <<SQL || die "psql failed creating role/database" 3
CREATE ROLE $user WITH LOGIN PASSWORD '$password';
CREATE DATABASE $app OWNER $user;
SQL

    # Schema/connect grants run inside the new DB and are transactional.
    psql_admin --single-transaction -d "$app" <<SQL || die "psql failed configuring database" 3
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT ALL ON SCHEMA public TO $user;
REVOKE CONNECT ON DATABASE $app FROM PUBLIC;
GRANT CONNECT ON DATABASE $app TO $user;
SQL

    if [[ "${PGM_PG_STAT_STATEMENTS,,}" != "false" ]]; then
        psql_admin -d "$app" -c "CREATE EXTENSION IF NOT EXISTS pg_stat_statements;" \
            || printf '⚠  pg_stat_statements not enabled (is it in shared_preload_libraries?)\n'
    fi

    local env_file="$PGM_SECRETS_DIR/$app.env" saved_path=''
    if [[ "${PGM_SAVE_ENV,,}" != "false" ]]; then
        write_env_file "$app" "$password"
        saved_path="$env_file"
    fi

    print_creds_block "App database created" "$app" "$password" "$saved_path"

    if [[ "${PGM_SUGGEST_HBA_CHANGE,,}" != "false" ]]; then
        printf '\n'
        printf 'ℹ pg_hba.conf reminder\n\n'
        printf '  If the application connects from a host other than this one,\n'
        printf '  pg_hba.conf must permit it. Add a line like:\n\n'
        printf '    host    %s    %s    <client-ip>/<mask>    scram-sha-256\n\n' "$app" "$user"
        printf "  then reload:  sudo -u postgres psql -c 'SELECT pg_reload_conf();'\n"
        printf '  Disable this hint with PGM_SUGGEST_HBA_CHANGE=false\n'
    fi
}

# ---------------------------------------------------------------------------
# delete
# ---------------------------------------------------------------------------
cmd_delete() {
    [ $# -eq 1 ] || die "Usage: pgm delete <app>"
    local app=$1
    validate_app_name "$app"
    local user="${app}${USER_SUFFIX}"

    role_exists "$user"          || die "Role '$user' does not exist." 2
    role_owns_db "$user" "$app"  || die "Role '$user' does not own database '$app' — refusing to delete." 2

    local size conns
    size=$(psql_query  -c "SELECT pg_size_pretty(pg_database_size('$app'))")
    conns=$(psql_query -c "SELECT count(*) FROM pg_stat_activity WHERE datname='$app'")

    printf '\n⚠  DESTRUCTIVE ACTION\n\n'
    printf '   Database:    %s  (%s)\n' "$app" "$size"
    printf '   Owner:       %s\n'       "$user"
    printf '   Connections: %s\n'       "$conns"
    printf '\nThis will:\n'
    printf '  • Terminate all active connections to %s\n' "$app"
    printf '  • DROP DATABASE %s\n'                       "$app"
    printf '  • DROP ROLE %s\n'                           "$user"
    printf '  • Remove %s/%s.env (if present)\n'          "$PGM_SECRETS_DIR" "$app"
    printf '\nThis cannot be undone.\n\n'

    local typed=''
    read -r -p "Type the app name to confirm: " typed || true
    [ "$typed" = "$app" ] || { printf 'Aborted.\n'; exit 1; }

    # DROP DATABASE also cannot run inside a transaction.
    psql_admin <<SQL || die "psql failed during delete" 3
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$app' AND pid <> pg_backend_pid();
DROP DATABASE $app;
DROP ROLE $user;
SQL

    printf '✓ Database %s deleted\n' "$app"
    printf '✓ Role %s deleted\n'     "$user"

    local env_file="$PGM_SECRETS_DIR/$app.env"
    if [ -f "$env_file" ]; then
        rm -f "$env_file"
        printf '✓ Removed %s\n' "$env_file"
    fi
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
cmd_list() {
    local rows
    rows=$(psql_query -F $'\t' -c "
        SELECT d.datname,
               r.rolname,
               pg_size_pretty(pg_database_size(d.oid)),
               pg_database_size(d.oid)
        FROM pg_database d
        JOIN pg_roles r ON d.datdba = r.oid
        WHERE right(r.rolname, ${#USER_SUFFIX}) = '$USER_SUFFIX'
        ORDER BY d.datname")

    if [ -z "$rows" ]; then
        printf 'No app databases found.\n'
        return 0
    fi

    printf '%-25s  %-25s  %-12s\n' 'APP NAME' 'OWNER' 'SIZE'
    local total=0 count=0 name owner size bytes
    while IFS=$'\t' read -r name owner size bytes; do
        printf '%-25s  %-25s  %-12s\n' "$name" "$owner" "$size"
        total=$((total + bytes))
        count=$((count + 1))
    done <<< "$rows"

    local total_pretty
    total_pretty=$(psql_query -c "SELECT pg_size_pretty($total::bigint)")
    printf '\n%d apps, %s total\n' "$count" "$total_pretty"
}

# ---------------------------------------------------------------------------
# info
# ---------------------------------------------------------------------------
cmd_info() {
    [ $# -eq 1 ] || die "Usage: pgm info <app>"
    local app=$1
    validate_app_name "$app"
    local user="${app}${USER_SUFFIX}"

    db_exists "$app" || die "Database '$app' does not exist." 2

    local size conns exts
    size=$(psql_query  -c "SELECT pg_size_pretty(pg_database_size('$app'))")
    conns=$(psql_query -c "SELECT count(*) FROM pg_stat_activity WHERE datname='$app'")
    exts=$(psql_query  -d "$app" -c "SELECT coalesce(string_agg(extname, ', '), '(none)') FROM pg_extension WHERE extname <> 'plpgsql'")

    local env_file="$PGM_SECRETS_DIR/$app.env" stored='(not saved)'
    [ -f "$env_file" ] && stored="$env_file"

    printf 'Database:        %s\n' "$app"
    printf 'Owner:           %s\n' "$user"
    printf 'Size:            %s\n' "$size"
    printf 'Connections:     %s active\n' "$conns"
    printf 'Extensions:      %s\n' "$exts"
    printf '\nCredentials:\n'
    printf '  Stored at:     %s\n' "$stored"
    printf '  URL:           postgresql://%s:***@%s:%s/%s\n' \
        "$user" "$PGM_DB_HOST" "$PGM_DB_PORT" "$app"
}

# ---------------------------------------------------------------------------
# rotate-password
# ---------------------------------------------------------------------------
cmd_rotate() {
    [ $# -eq 1 ] || die "Usage: pgm rotate-password <app>"
    local app=$1
    validate_app_name "$app"
    local user="${app}${USER_SUFFIX}"

    role_exists "$user"          || die "Role '$user' does not exist." 2
    role_owns_db "$user" "$app"  || die "Role '$user' does not own database '$app' — refusing." 2

    printf '\n⚠  Rotating password for %s\n\n' "$app"
    printf 'This will:\n'
    printf '  • Generate a new password\n'
    printf "  • Update %s's password in PostgreSQL\n" "$user"
    printf '  • Update %s/%s.env (if present)\n' "$PGM_SECRETS_DIR" "$app"
    printf '\nThe OLD password will stop working immediately.\n'
    printf 'The application MUST be redeployed with the new password.\n\n'

    local cont=''
    read -r -p "Continue? [y/N]: " cont || true
    [[ "$cont" =~ ^[Yy]$ ]] || { printf 'Aborted.\n'; exit 1; }

    local password
    password=$(gen_password)

    psql_admin -c "ALTER USER $user WITH PASSWORD '$password';" \
        || die "psql failed during password rotation" 3

    local env_file="$PGM_SECRETS_DIR/$app.env" saved_path=''
    if [ -f "$env_file" ]; then
        write_env_file "$app" "$password"
        saved_path="$env_file"
    fi

    print_creds_block "Password rotated for" "$app" "$password" "$saved_path"
}

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------
cmd_help() {
    cat <<'EOF'
pgm — manage PostgreSQL application databases

Usage:
  pgm <command> [args]

Commands:
  create <app>             Create a new application database + user
  delete <app>             Delete an application database + user
  list                     List all application databases
  info <app>               Show details for one application database
  rotate-password <app>    Generate a new password for an app's user
  help                     Show this help

Configuration (environment variables):
  PGM_DB_HOST              Host shown in connection strings (default: localhost)
  PGM_DB_PORT              Port shown in connection strings (default: 5432)
  PGM_SECRETS_DIR          Where .env files are stored (default: /root/.pg-app-secrets)
  PGM_PSQL_CMD             Admin psql command (default: sudo -u postgres psql)
  PGM_SAVE_ENV             Save .env file on create (default: true)
  PGM_PG_STAT_STATEMENTS   Enable pg_stat_statements on create (default: true)
  PGM_SUGGEST_HBA_CHANGE   Print pg_hba.conf reminder after create (default: true)

Or use /etc/pgm/pgm.conf to set permanent defaults.

Exit codes:
  0  success
  1  user aborted / unknown command
  2  validation error
  3  psql / Postgres error
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
[ $# -ge 1 ] || { cmd_help; exit 0; }
cmd=$1; shift
case "$cmd" in
    create)             cmd_create "$@" ;;
    delete)             cmd_delete "$@" ;;
    list)               cmd_list   "$@" ;;
    info)               cmd_info   "$@" ;;
    rotate-password)    cmd_rotate "$@" ;;
    help)               cmd_help ;;
    *) printf "Unknown command: %s. Try 'pgm help'.\n" "$cmd" >&2; exit 1 ;;
esac
